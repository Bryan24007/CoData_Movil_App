<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SeguimientoApp.MVVM.Views.SeguimientoPage"
             xmlns:vm="clr-namespace:SeguimientoApp.MVVM.ViewModels"
             xmlns:models="clr-namespace:SeguimientoApp.MVVM.Models"
             Title="SeguimientoPage">
    
    
    <ContentPage.BindingContext>
        <vm:SeguimientoViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,*" Padding="15">

        <!-- Barra de búsqueda -->
        <Frame Grid.Row="0" 
               BackgroundColor="White" 
               CornerRadius="25" 
               Padding="5,0"
               HasShadow="True"
               BorderColor="Transparent">
            <SearchBar Placeholder="Buscar en reportes..."
                       Text="{Binding TextoBusqueda}"
                       BackgroundColor="Transparent"
                       CancelButtonColor="#4CAF50"/>
        </Frame>

        <!-- Contador de reportes -->
        <Label Grid.Row="1" 
               Text="{Binding ContadorReportes, StringFormat='{0} reportes encontrados'}"
               TextColor="#666666"
               FontSize="14"
               Margin="5,10,0,5"/>

        <!-- Lista de reportes -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefrescarCommand}">

            <CollectionView ItemsSource="{Binding ReportesFiltrados}"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Reporte">
                        <Frame Margin="0,5" 
                               Padding="0" 
                               CornerRadius="10"
                               BackgroundColor="White"
                               HasShadow="True"
                               BorderColor="{Binding BorderColor}">

                            <Grid>
                                <!-- Barra lateral de color según estado -->
                                <BoxView WidthRequest="5"
                                         HorizontalOptions="Start"
                                         BackgroundColor="{Binding BorderColor}"
                                         CornerRadius="10,0,0,10"/>

                                <VerticalStackLayout Padding="15,10" Margin="5,0,0,0">

                                    <!-- Encabezado: ID y Estado -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Id}"
                                               FontSize="12"
                                               TextColor="#888888"/>
                                        <Ellipse Grid.Column="1"
                                                 WidthRequest="12"
                                                 HeightRequest="12"
                                                 Fill="{Binding EstadoColor}"/>
                                    </Grid>

                                    <!-- Título -->
                                    <Label Text="{Binding Titulo}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#333333"
                                           Margin="0,5,0,0"/>

                                    <!-- Fecha y Autor -->
                                    <HorizontalStackLayout Spacing="15" Margin="0,5,0,0">
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="📅" FontSize="12"/>
                                            <Label Text="{Binding FechaFormateada}"
                                                   FontSize="12"
                                                   TextColor="#666666"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="👤" FontSize="12"/>
                                            <Label Text="{Binding Autor}"
                                                   FontSize="12"
                                                   TextColor="#666666"/>
                                        </HorizontalStackLayout>
                                    </HorizontalStackLayout>

                                    <!-- Badge de Estado -->
                                    <Border Margin="0,8,0,0"
                                            Stroke="Transparent"
                                            BackgroundColor="#E8E8E8"
                                            StrokeShape="RoundRectangle 12"
                                            HorizontalOptions="Start"
                                            Padding="10,5">
                                        <Label Text="{Binding EstadoTexto}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#555555"/>
                                    </Border>

                                    <!-- Contenido expandible (Detalles) -->
                                    <VerticalStackLayout x:Name="DetallesPanel"
                                                        IsVisible="False"
                                                        Margin="0,10,0,0">

                                        <BoxView HeightRequest="1" 
                                                 Color="#EEEEEE" 
                                                 Margin="0,0,0,10"/>

                                        <!-- Descripción -->
                                        <Label Text="Descripción:" 
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               TextColor="#444444"/>
                                        <Label Text="{Binding Descripcion}"
                                               FontSize="13"
                                               TextColor="#666666"
                                               Margin="0,2,0,8"/>

                                        <!-- Categoría -->
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="Categoría:"
                                                   FontAttributes="Bold"
                                                   FontSize="13"/>
                                            <Label Text="{Binding Categoria}"
                                                   FontSize="13"
                                                   TextColor="#666666"/>
                                        </HorizontalStackLayout>

                                        <!-- Prioridad -->
                                        <HorizontalStackLayout Spacing="5" Margin="0,5,0,0">
                                            <Label Text="Prioridad:"
                                                   FontAttributes="Bold"
                                                   FontSize="13"/>
                                            <Label Text="{Binding PrioridadTexto}"
                                                   FontSize="13"
                                                   TextColor="{Binding PrioridadColor}"
                                                   FontAttributes="Bold"/>
                                        </HorizontalStackLayout>

                                        <!-- Contacto -->
                                        <HorizontalStackLayout Spacing="5" Margin="0,5,0,0">
                                            <Label Text="Contacto:"
                                                   FontAttributes="Bold"
                                                   FontSize="13"/>
                                            <Label Text="{Binding Contacto}"
                                                   FontSize="13"
                                                   TextColor="#2196F3"
                                                   TextDecorations="Underline">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer 
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SeguimientoViewModel}}, Path=LlamarContactoCommand}"
                                                        CommandParameter="{Binding .}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </HorizontalStackLayout>

                                        <!-- Ubicación -->
                                        <HorizontalStackLayout Spacing="5" Margin="0,5,0,0">
                                            <Label Text="📍" FontSize="13"/>
                                            <Label Text="Ubicación:"
                                                   FontAttributes="Bold"
                                                   FontSize="13"/>
                                            <Label Text="{Binding Ubicacion}"
                                                   FontSize="13"
                                                   TextColor="#666666"/>
                                        </HorizontalStackLayout>

                                        <!-- Botones de acción -->
                                        <HorizontalStackLayout Spacing="10" 
                                                              Margin="0,15,0,5"
                                                              HorizontalOptions="Start">
                                            <Button Text="ACTUALIZAR"
                                                    BackgroundColor="#4CAF50"
                                                    TextColor="White"
                                                    FontSize="12"
                                                    CornerRadius="5"
                                                    HeightRequest="35"
                                                    Padding="15,0"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SeguimientoViewModel}}, Path=ActualizarReporteCommand}"
                                                    CommandParameter="{Binding .}"/>

                                            <Button Text="VER MAPA"
                                                    BackgroundColor="#666666"
                                                    TextColor="White"
                                                    FontSize="12"
                                                    CornerRadius="5"
                                                    HeightRequest="35"
                                                    Padding="15,0"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SeguimientoViewModel}}, Path=VerMapaCommand}"
                                                    CommandParameter="{Binding .}"/>

                                            <Button Text="ELIMINAR"
                                                    BackgroundColor="#F44336"
                                                    TextColor="White"
                                                    FontSize="12"
                                                    CornerRadius="5"
                                                    HeightRequest="35"
                                                    Padding="15,0"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SeguimientoViewModel}}, Path=EliminarReporteCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Tap para expandir -->
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnReporteTapped"/>
                            </Frame.GestureRecognizers>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" 
                                        HorizontalOptions="Center"
                                        Padding="20">
                        <Label Text="📋" FontSize="50" HorizontalOptions="Center"/>
                        <Label Text="No se encontraron reportes"
                               FontSize="18"
                               TextColor="#888888"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>