<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SeguimientoApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SeguimientoApp"
    xmlns:views="clr-namespace:SeguimientoApp.MVVM.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="SeguimientoApp">

    <TabBar>
       

        <ShellContent 
            Title="Seguimiento"
            Icon="chart.png"
            ContentTemplate="{DataTemplate views:SeguimientoPage}" />

        
    </TabBar>

    <!-- Estilos del Shell -->
    <Shell.Resources>
        <ResourceDictionary>
            <Style x:Key="BaseStyle" TargetType="Element">
                <Setter Property="Shell.BackgroundColor" Value="White"/>
                <Setter Property="Shell.ForegroundColor" Value="#333333"/>
                <Setter Property="Shell.TitleColor" Value="#333333"/>
                <Setter Property="Shell.TabBarBackgroundColor" Value="White"/>
                <Setter Property="Shell.TabBarForegroundColor" Value="#333333"/>
                <Setter Property="Shell.TabBarUnselectedColor" Value="#999999"/>
                <Setter Property="Shell.TabBarTitleColor" Value="#4CAF50"/>
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

</Shell>
