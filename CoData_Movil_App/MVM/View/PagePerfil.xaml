<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoData_Movil_App.MVM.View.PagePerfil"
              NavigationPage.HasNavigationBar="False"
             Title="PagePerfil">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#ffffff" Offset="0.0" />
            <GradientStop Color="#adecff" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>
    <ScrollView>
        
        <StackLayout Padding="20" Spacing="20">
            <Label Text="Mi Perfil" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

            <!-- Foto de Perfil -->
            <Frame BackgroundColor="#F5F5F5" Padding="15">
                <StackLayout HorizontalOptions="Center" Spacing="10">
                    <Label Text="Imagen de Perfil" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Image Source="user_placeholder.png" HeightRequest="100" WidthRequest="100" HorizontalOptions="Center"/>
                    <Label Text="Sube tu foto (JPG, PNG)" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                    <Button Text="Cambiar Foto" Clicked="OnCambiarFotoClicked" BackgroundColor="#2196F3" TextColor="White"/>
                </StackLayout>
            </Frame>
            <Image x:Name="userImage" 
                   Source="user_placeholder.png" 
                   HeightRequest="100" 
                   WidthRequest="100" 
                   HorizontalOptions="Center"/>

            <BoxView HeightRequest="1" Color="#E0E0E0"/>

            <!-- Información de la raza-->
            <StackLayout Spacing="15">
                <StackLayout>
                    <Label Text="Nombre Completo" FontAttributes="Bold"/>
                    <Entry x:Name="txtNombre" Placeholder="Ingresa tu nombre completo"/>
                </StackLayout>

                <StackLayout>
                    <Label Text="Correo Electrónico" FontAttributes="Bold"/>
                    <Entry x:Name="txtCorreo" Placeholder="correo@ejemplo.com" IsEnabled="False"/>
                    <Label Text="El correo no se puede cambiar" FontSize="12" TextColor="Gray"/>
                </StackLayout>

                <StackLayout>
                    <Label Text="Nueva Contraseña" FontAttributes="Bold"/>
                    <Entry x:Name="txtNuevaPassword" Placeholder="Deja en blanco para no cambiar" IsPassword="True"/>
                </StackLayout>

                <StackLayout>
                    <Label Text="Confirmar Nueva Contraseña" FontAttributes="Bold"/>
                    <Entry x:Name="txtConfirmarPassword" Placeholder="Repite la nueva contraseña" IsPassword="True"/>
                </StackLayout>
            </StackLayout>

            <Button Text="GUARDAR CAMBIOS" Clicked="OnGuardarCambiosClicked" BackgroundColor="#66CDAA" TextColor="White" FontAttributes="Bold"/>
            <Button Text="Cerrar Sesión" BackgroundColor="#E9967A" TextColor="White" FontAttributes="Bold" Clicked="loginPage"/>

            <!-- Barra de Navegación -->
            <Grid BackgroundColor="#F0FFF0"
 Padding="10"
AbsoluteLayout.LayoutBounds="0,1,1,0.1"
AbsoluteLayout.LayoutFlags="PositionProportional"
VerticalOptions="Center"
    HorizontalOptions="Center">

                <Grid.Clip>
                    <RoundRectangleGeometry CornerRadius="30"
                  Rect="1,10,300,90"/>
                </Grid.Clip>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ImageButton Grid.Column="0" Source="icono_casa.png" Clicked="PageMenu" />
                <ImageButton Grid.Column="1" Source="icono_seguimiento.png" Clicked="PageSeguimiento" />
                <ImageButton Grid.Column="2" Source="icono_mapa.png" />
                <ImageButton Grid.Column="3" Source="icono_user.png" />

            </Grid>
        </StackLayout>
       
    </ScrollView>
</ContentPage>